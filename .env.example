# ==========================================================================
# Outskill Hackathon Judge — environment template
#
# Copy to .env and fill in. Never commit .env. Never paste secrets into chat.
# Every value below is intentionally EMPTY.
#
# With DEMO_MODE=1 the entire platform runs locally with none of the
# external services below configured.
# ==========================================================================

# --------------------------------------------------------------------------
# Runtime mode
# --------------------------------------------------------------------------
# 1 = deterministic fixtures, in-memory data, no AI key, no Supabase, no worker
# 0 = real infrastructure (requires Supabase + credential key below)
DEMO_MODE=1
NODE_ENV=development

# Public base URL — used to build participant invite links
APP_BASE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Shared admin account (ONE account; there is no admin signup)
# --------------------------------------------------------------------------
# Seeds the single shared admin on first run. Password is hashed with Argon2id
# and never stored in plaintext. Rotate from /admin/settings afterwards.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Signing secret for admin session cookies. Generate 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --------------------------------------------------------------------------
# Credential encryption (AES-256-GCM)
# --------------------------------------------------------------------------
# Encrypts participant demo credentials at rest. EXACTLY 32 bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored credentials permanently unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Increment when rotating keys; old ciphertext records their key version.
CREDENTIAL_KEY_VERSION=1

# --------------------------------------------------------------------------
# Supabase (Phase 2+ — not required in demo mode)
# --------------------------------------------------------------------------
SUPABASE_URL=
# Server-side only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used for FOR UPDATE SKIP LOCKED queue claiming.
DATABASE_URL=

# --------------------------------------------------------------------------
# AI provider (Phase 3+ — not required in demo mode)
# --------------------------------------------------------------------------
# No provider is hard-coded. Supported: demo | anthropic | openai | custom
AI_PROVIDER=demo
AI_MODEL=
AI_API_KEY=
# Optional override for self-hosted or gateway endpoints
AI_BASE_URL=
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000

# --------------------------------------------------------------------------
# Assessment worker (Phase 4+)
# --------------------------------------------------------------------------
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000
# Hard wall-clock budget per submission's browser testing
BROWSER_TEST_BUDGET_MS=480000
BROWSER_HEADLESS=1
# Job lease; a crashed worker's jobs are reclaimed after this
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3

# --------------------------------------------------------------------------
# Cohort defaults
# --------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SHORTLIST_TARGET=10

# --------------------------------------------------------------------------
# Retention (days). Deletion NEVER runs in demo mode or outside production.
# --------------------------------------------------------------------------
RETENTION_EVIDENCE_DAYS=90
RETENTION_SUBMISSION_DAYS=90

# --------------------------------------------------------------------------
# Branding
# --------------------------------------------------------------------------
# The palette lives in CSS, not here.
#
# Colours come from DESIGN-SYSTEM.md via the token block in
# apps/web/src/app/globals.css, so there is nothing to configure per
# environment. BRAND_GREEN remains in the schema as an accepted-but-unused key
# and is deliberately left blank: the accent is Outskill orange, and an
# environment variable named after the old green would be a lie waiting for
# someone to believe it.
BRAND_GREEN=

# --- Google Sheets intake (Judge/Vercel server only; Railway does not need these) ---
# The dedicated Judge service account, with Viewer access to the submissions sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The full PEM. Platforms store this with escaped newlines; that is handled.
# NEVER commit a real key. NEVER paste one into a chat or a ticket.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=
# Which Judge cohort this sheet belongs to. Server configuration, never a
# column in the sheet and never something a learner types.
GOOGLE_SHEETS_EXTERNAL_COHORT_ID=
GOOGLE_SHEETS_COHORT_NAME=

# Service-to-service credential for the Outskill Hackathon product.
# Deliberately separate from WORKER_API_TOKEN.
PARTNER_API_TOKEN=
